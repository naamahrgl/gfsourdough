---
// src/components/Navigation.astro
import { navlinks, navlinkItem } from "../styles/styles";
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/config";

interface Props {
  lang: Lang;
  overrideClass?: string;
  containerClass?: string;
}

const { lang, overrideClass, containerClass } = Astro.props;

const container = containerClass ?? navlinks;
const linkClass = overrideClass ?? navlinkItem;

const t = useTranslations(lang);
const base = `/${lang}`;
---

<div id="navlinks" class={container}>
  <a href={`${base}/`} class={linkClass}>{t('nav.home')}</a>
  <a href={`${base}/courses/`} class={linkClass}>{t('nav.courses')}</a>
  <a href={`${base}/blog/`} class={linkClass}>{t('nav.blog')}</a>
  <a href={`${base}/recipes/`} class={linkClass}>{t('nav.recipes')}</a>
  <a href={`${base}/about/`} class={linkClass}>{t('nav.about')}</a>
</div>