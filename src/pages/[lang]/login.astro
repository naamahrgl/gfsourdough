---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AuthPage from '../../components/auth/AuthPage.tsx';
import { languages, type Lang } from '../../i18n/config';
 
export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
 
const lang = Astro.params.lang;
const currentLang: Lang = (lang && lang in languages ? lang : 'en') as Lang;
---
 
<BaseLayout lang={currentLang} pageTitle="Log in" description="Log in to your account">
  <AuthPage client:only="react" lang={currentLang} redirectTo={`/${currentLang}/dashboard`} />
</BaseLayout>