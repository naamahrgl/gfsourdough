---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResetPasswordPage from '../../components/auth/ResetPasswordPage.tsx';
import { languages, type Lang } from '../../i18n/config';
 
export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
 
const lang = Astro.params.lang;
const currentLang: Lang = (lang && lang in languages ? lang : 'en') as Lang;
---
 
<BaseLayout lang={currentLang} pageTitle="Reset password" description="Set a new password">
  <ResetPasswordPage
    client:only="react"
    lang={currentLang}
    loginHref={`/${currentLang}/login`}
  />
</BaseLayout>