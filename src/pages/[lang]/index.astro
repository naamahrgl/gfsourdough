---
import { languages, type Lang } from '../../i18n/config';
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductGrid from '../../components/ProductGrid.tsx';

const t = {
  title: "Naama Ofir | Video editor, motion designer & 3D character animator",
 description: "Video editor, motion designer and 3D character animator. Discover commercial projects, branded content, animation and photography by Naama Ofir."
};
export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const currentLang: Lang = (lang && lang in languages ? lang : 'en') as Lang;

---


<BaseLayout lang={currentLang} pageTitle={t.title} description={t.description}>
<ProductGrid client:only="react" lang={currentLang} />

</BaseLayout>